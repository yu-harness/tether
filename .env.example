# 模型后端：默认 deepseek，需要真实模型时取消注释并填 key
# PICO_DEEPSEEK_API_KEY=sk-...

# 外部追踪：默认关闭。取消注释即按 OpenTelemetry GenAI 语义约定上报。

# 方案一：本地 Jaeger（启动方式见 infra/jaeger/）
# PICO_TRACING=otel
# PICO_OTEL_ENDPOINT=http://localhost:4318/v1/traces

# 方案二：本地 Langfuse（启动方式见 infra/langfuse/）
# endpoint 指到 Langfuse 的 OTLP 接收口，headers 里放 Basic 认证
#（pk:sk 的 base64）和 v4 实时摄取标记，缺后者数据可能延迟十分钟才可见。
# PICO_TRACING=otel
# PICO_OTEL_ENDPOINT=http://localhost:3000/api/public/otel/v1/traces
# PICO_OTEL_HEADERS=Authorization=Basic <base64(pk-lf-...:sk-lf-...)>,x-langfuse-ingestion-version=4

# 采样率：0 到 1 之间的浮点数，默认 1（全采样），设 0 等于关闭。
# 按 run_id 做确定性采样，同一个 run 的事件要么全部上报，要么一条都不上报。
# PICO_TRACING_SAMPLE_RATE=0.2
